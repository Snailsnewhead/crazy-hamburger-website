generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EscapeAttempt {
  id        Int     @id @default(autoincrement())
  userId    Int
  stage     Int
  completed Boolean @default(false)
  timeSpent Int
  answers   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}